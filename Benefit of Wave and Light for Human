<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Light & Optics Learning</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

<!-- NAVBAR -->
<nav>
  <h2>🌊 Light & Optics</h2>
  <ul>
    <li><a href="#home">Home</a></li>
    <li><a href="#materi">Materi</a></li>
    <li><a href="#worksheet">Worksheet</a></li>
    <li><a href="#simulation">Simulation</a></li>
  </ul>
</nav>

<!-- HERO -->
<section id="home" class="hero">
  <h1>Welcome to Light & Optics World ✨</h1>
  <p>Explore waves, light, and vision in a fun way!</p>
  <button onclick="scrollToSection('materi')">Start Learning 🚀</button>
</section>

<!-- MATERI -->
<section id="materi">
  <h2>📚 Learning Material</h2>

  <div class="card">
    <h3>🌊 Waves</h3>
    <p>Wave is vibration that transfers energy.</p>
    <ul>
      <li>Frequency (f) = 1 / T</li>
      <li>Wave speed = λ × f</li>
    </ul>
  </div>

  <div class="card">
    <h3>💡 Light Properties</h3>
    <ul>
      <li>Travels in straight line</li>
      <li>Reflection</li>
      <li>Refraction</li>
    </ul>
  </div>

  <div class="card">
    <h3>👁️ Human Eye</h3>
    <p>Cornea → Pupil → Lens → Retina → Brain</p>
  </div>

  <button onclick="scrollToSection('worksheet')">Go to Worksheet ➡️</button>
</section>

<!-- WORKSHEET -->
<section id="worksheet">
  <h2>🧪 Worksheet: Lens Power</h2>

  <div class="card">
    <h3>🔍 Research Question</h3>
    <textarea placeholder="Write your question..."></textarea>
  </div>

  <div class="card">
    <h3>🧠 Hypothesis</h3>
    <textarea placeholder="If..., then..., because..."></textarea>
  </div>

  <div class="card">
    <h3>📊 Calculation</h3>
    <input type="number" id="focal" placeholder="Focal Length (m)">
    <button onclick="calculateDiopter()">Calculate</button>
    <p id="result"></p>
  </div>

  <button onclick="scrollToSection('simulation')">Try Simulation 🔬</button>
</section>
<!-- QUIZ -->
<section id="quiz">
  <h2>🎮 Quiz Time!</h2>

  <div class="card">
    <p>1. What is the unit of frequency?</p>
    <button onclick="checkAnswer(this, true)">Hertz</button>
    <button onclick="checkAnswer(this, false)">Meter</button>
  </div>

  <div class="card">
    <p>2. What type of wave is light?</p>
    <button onclick="checkAnswer(this, true)">Electromagnetic</button>
    <button onclick="checkAnswer(this, false)">Mechanical</button>
  </div>

  <h3 id="score">Score: 0</h3>

  <button onclick="scrollToSection('home')">Finish 🎉</button>
</section>

<!-- SIMULATION -->
<section id="simulation">
  <h2>🔬 PhET Simulation</h2>
  <p>Explore how lenses bend light!</p>

  <iframe src="https://phet.colorado.edu/sims/html/geometric-optics/latest/geometric-optics_en.html"
          width="800" height="500"></iframe>

  <button onclick="scrollToSection('home')">Back to Top ⬆️</button>
</section>

<script src="script.js"></script>
</body>
</html>
body {
  margin: 0;
  font-family: 'Poppins', sans-serif;
  scroll-behavior: smooth;
}

/* COLOR PALETTE */
:root {
  --blue: #3b7ca6;
  --light-blue: #9fc4cf;
  --green: #7fb04f;
  --yellow: #d6cf6a;
  --brown: #7b4a34;
}

/* NAVBAR */
nav {
  background: var(--blue);
  color: white;
  display: flex;
  justify-content: space-between;
  padding: 15px;
}

nav ul {
  list-style: none;
  display: flex;
  gap: 20px;
}

/* HERO */
.hero {
  background: linear-gradient(var(--light-blue), var(--green));
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-align: center;
}

.hero h1 {
  font-size: 40px;
  animation: fadeIn 2s ease-in-out;
}

/* SECTIONS */
section {
  padding: 50px;
  text-align: center;
}

/* CARD */
.card {
  background: white;
  margin: 20px auto;
  padding: 20px;
  width: 70%;
  border-radius: 15px;
  box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  transition: 0.3s;
}

.card:hover {
  transform: scale(1.05);
}

/* BUTTON */
button {
  background: var(--yellow);
  border: none;
  padding: 10px 20px;
  border-radius: 10px;
  cursor: pointer;
}

button:hover {
  background: var(--green);
  color: white;
}

/* ANIMATION */
@keyframes fadeIn {
  from {opacity: 0;}
  to {opacity: 1;}
}
/* RESPONSIVE */
@media (max-width: 768px) {
  .card {
    width: 90%;
  }

  nav {
    flex-direction: column;
    align-items: center;
  }

  iframe {
    width: 100%;
    height: 300px;
  }

  .hero h1 {
    font-size: 28px;
  }
}

/* QUIZ BUTTON */
.card button {
  margin: 5px;
}
function scrollToSection(id) {
  document.getElementById(id).scrollIntoView({
    behavior: "smooth"
  });
}

function calculateDiopter() {
  let f = document.getElementById("focal").value;

  if (f == 0 || f === "") {
    document.getElementById("result").innerText = "Enter valid number!";
    return;
  }

  let d = 1 / f;
  document.getElementById("result").innerText =
    "Diopter = " + d.toFixed(2) + " D";
}
let score = 0;

// QUIZ
function checkAnswer(button, isCorrect) {
  if (isCorrect) {
    score++;
    button.style.background = "green";
  } else {
    button.style.background = "red";
  }

  document.getElementById("score").innerText = "Score: " + score;
}

// AUTO GRADING WORKSHEET
function calculateDiopter() {
  let f = document.getElementById("focal").value;

  if (f == 0 || f === "") {
    document.getElementById("result").innerText = "Enter valid number!";
    return;
  }

  let d = 1 / f;

  let feedback = "";
  if (d > 2) {
    feedback = "Strong lens 💪";
  } else if (d > 0) {
    feedback = "Moderate lens 👍";
  } else {
    feedback = "Weak or concave lens 👓";
  }

  document.getElementById("result").innerText =
    "Diopter = " + d.toFixed(2) + " D (" + feedback + ")";
}
